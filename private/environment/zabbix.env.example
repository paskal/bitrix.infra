# Zabbix Agent 2 configuration
# https://hub.docker.com/r/zabbix/zabbix-agent2

# timezone for the agent (should match the server timezone)
TZ=UTC

# hostname as registered in the Zabbix server
ZBX_HOSTNAME=myhostname

# address of the Zabbix server
ZBX_SERVER_HOST=zabbix.example.com

# encrypt traffic with the Zabbix server: active checks, passive checks and zabbix_sender
# accept nothing but PSK. Create the key once and enter the same identity and key on the host
# in Zabbix (Encryption tab: connections to host PSK, connections from host PSK only):
#   openssl rand -hex 32 > private/environment/zabbix-agent.psk
#   sudo chown 1997:1997 private/environment/zabbix-agent.psk && sudo chmod 0400 private/environment/zabbix-agent.psk
# docker-compose.yml mounts that file at the path below and refuses to start the agent without it.
ZBX_TLSCONNECT=psk
ZBX_TLSACCEPT=psk
ZBX_TLSPSKIDENTITY=myhostname-agent
ZBX_TLSPSKFILE=/var/lib/zabbix/enc/agent.psk

# restrict which monitoring keys the agent can execute
# https://www.zabbix.com/documentation/current/en/manual/config/items/restrict_checks
# since Zabbix 8.0 the image takes only indexed variables: ZBX_ALLOWKEY_N and ZBX_DENYKEY_N share
# one index sequence starting at 0, each holds a single pattern, and a duplicate or unindexed one
# stops the agent. The templates in config/zabbix/templates use system.run, so it is allowed here.
ZBX_ALLOWKEY_0=system.run[*]

# MySQL setup for database monitoring:
#   CREATE USER 'zbx_monitor'@'localhost' IDENTIFIED BY 'random_password';
#   GRANT PROCESS, REPLICATION CLIENT, SHOW DATABASES, SHOW VIEW ON *.* TO 'zbx_monitor'@'localhost';
# Copy config/zabbix/mysql-session.conf.example to
# private/environment/zabbix-mysql-session.conf and put the credentials there.
# In Zabbix, set {$MYSQL.DSN} to LocalMysql and leave {$MYSQL.USER} and
# {$MYSQL.PASSWORD} empty so credentials never enter item keys.
