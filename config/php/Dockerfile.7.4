FROM ubuntu:noble

# phpdockerio/php:7.4-fpm is built on Ubuntu 20.04, for which the ondrej/php repository no longer publishes packages,
# so this image repeats its steps on Ubuntu 24.04, where PHP 7.4 still receives backported security fixes.

LABEL org.opencontainers.image.authors="Dmitry Verkhoturov <paskal.07@gmail.com>" \
      org.opencontainers.image.description="PHP-fpm 7.4 with everything needed for Bitrix" \
      org.opencontainers.image.documentation="https://github.com/paskal/bitrix.infra" \
      org.opencontainers.image.source="https://github.com/paskal/bitrix.infra" \
      org.opencontainers.image.title="bitrix-php-7.4" \
      org.opencontainers.image.vendor="Dmitry Verkhoturov"

ENV DEBIAN_FRONTEND=noninteractive \
    TERM=linux

RUN apt-get update \
    && apt-get -y --no-install-recommends install ca-certificates curl gnupg \
    && curl -fsSL 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x14AA40EC0831756756D7F66C4F4EA0AAE5267A6C' \
       | gpg --dearmor -o /usr/share/keyrings/ondrej-php.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/ondrej-php.gpg] https://ppa.launchpadcontent.net/ondrej/php/ubuntu noble main" \
       > /etc/apt/sources.list.d/ondrej-php.list

# Pull PHP security releases from the package repository on every CI run. APT_REFRESH changes on every CI run, so this
# layer and the ones after it are rebuilt instead of replayed from the build cache.
ARG APT_REFRESH=0
RUN echo "apt refresh ${APT_REFRESH}" && apt-get update && apt-get -y --no-install-recommends upgrade

# the phpdockerio base set, then the Bitrix extensions the 8.x images add
RUN apt-get -y --no-install-recommends install \
    unzip \
    php7.4-apcu \
    php7.4-cli \
    php7.4-curl \
    php7.4-fpm \
    php7.4-json \
    php7.4-readline \
    php7.4-xml \
    php7.4-gd \
    php7.4-imagick \
    php7.4-intl \
    php7.4-mbstring \
    php7.4-memcache \
    php7.4-memcached \
    php7.4-mysql \
    php7.4-opcache \
    php7.4-redis \
    php7.4-soap \
    php7.4-xdebug \
    php7.4-zip \
    && ln -s /usr/sbin/php-fpm7.4 /usr/sbin/php-fpm

RUN apt-get -y --no-install-recommends install \
    webp \
    msmtp \
    msmtp-mta \
    sudo \
    cron

# msmtp to allow email sending
# msmtp-mta to allow sendmail usage with msmtp
# sudo to allow create logfile with www-data user
# cron to run cronjobs in a separate container

RUN apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /usr/share/doc/*

# the pool overrides phpdockerio ships as z-overrides.conf: foreground, logs to stderr, listen on 9000 over the network
RUN printf '%s\n' \
    '[global]' \
    'pid = /run/php-fpm.pid' \
    'error_log = /proc/self/fd/2' \
    'process_control_timeout = 30' \
    'daemonize = no' \
    '[www]' \
    'listen = [::]:9000' \
    'access.log = /proc/self/fd/2' \
    'catch_workers_output = yes' \
    'decorate_workers_output = no' \
    'clear_env = no' \
    > /etc/php/7.4/fpm/pool.d/z-overrides.conf

# without this, php in the container won't work if you forget to mount 90-php.ini
COPY ./90-php.ini /etc/php/7.4/fpm/conf.d/90-php.ini
COPY ./90-php.ini /etc/php/7.4/cli/conf.d/90-php.ini
# disable xdebug by default as it affects performance badly
COPY ./xdebug.ini /etc/php/7.4/mods-available/xdebug.ini

RUN groupmod -g 2000 ubuntu && \
    usermod -u 2000 -g 2000 ubuntu && \
    usermod -u 1000 www-data && \
    groupmod -g 1000 www-data

RUN echo "www-data" >> /etc/cron.deny && \
    chmod 644 /etc/cron.deny && \
    chmod -R 755 /etc/php/ && \
    chown -R root:root /etc/php/

HEALTHCHECK --interval=30s --timeout=10s --retries=10 --start-period=10s \
  CMD php --ini || exit 1

STOPSIGNAL SIGQUIT
EXPOSE 9000
CMD ["/usr/sbin/php-fpm", "-O"]
